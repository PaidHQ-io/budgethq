# @tremor/react@3.18.7's peer dependency range (react@^18.0.0) predates React 19 -- the package
# itself works fine on 19 in practice (see AccountPlanning.jsx's own doc comment), but a plain
# `npm install` refuses to resolve the tree without this. Without an .npmrc, that only applies to
# installs run locally with the flag passed explicitly -- Vercel's own build-time `npm install`
# doesn't know about it and fails with the same ERESOLVE error (2026-08-06, per Mo's deployment log
# screenshot). This makes every installer (local, CI, Vercel) resolve the same way.
legacy-peer-deps=true
